     overview_checkout_unavailable:::terminal
     overview_system_reserves_checkout:::systemAction
     overview_order_new:::orderStatus
     overview_payment_confirmed:::decision
     overview_system_handles_unpaid_checkout:::systemAction
     overview_order_closed:::orderStatus
     overview_queue_released_unpaid:::queueStatus
     overview_unpaid_end:::terminal
     overview_order_ready:::orderStatus
