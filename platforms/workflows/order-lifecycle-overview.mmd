     overview_queue_waiting:::queueStatus
     overview_system_waits_fifo:::systemAction
     overview_oldest_eligible:::decision
     overview_queue_running:::queueStatus
     overview_system_starts_task:::systemAction
     overview_task_in_progress:::taskStatus
     overview_delivery_on_time:::decision
     overview_seller_confirms_delivery:::sellerAction
     overview_artifact_submitted:::artifactStatus
     overview_task_delivered:::taskStatus
     overview_last_unfinished_task:::decision
     overview_order_active_review:::orderStatus
     overview_order_delivered:::orderStatus
     overview_buyer_acts_in_time:::decision
     overview_system_auto_approves:::systemAction
     overview_buyer_outcome:::decision
     overview_buyer_approves:::buyerAction
     overview_artifact_approved:::artifactStatus
     overview_task_completed:::taskStatus
     overview_system_records_earning:::systemAction
     overview_more_tasks:::decision
     overview_system_schedules_next:::systemAction
     overview_buyer_requests_revision:::buyerAction
     overview_system_accepts_revision:::systemAction
     overview_buyer_opens_dispute:::buyerAction
     overview_task_disputed:::taskStatus
     overview_later_tasks_on_hold:::taskStatus
     overview_queue_blocked:::queueStatus
     overview_system_promotes_after_block:::systemAction
     overview_dispute_end:::terminal
     overview_order_completed:::orderStatus
     overview_queue_released_completed:::queueStatus
     overview_completed_end:::terminal
     overview_system_cancels_current:::systemAction
     overview_current_task_canceled:::taskStatus
     overview_system_cancels_later:::systemAction
     overview_later_tasks_canceled:::taskStatus
     overview_order_canceled:::orderStatus
     overview_queue_released_canceled:::queueStatus
     overview_system_marks_finance:::systemAction
     overview_system_promotes_after_cancel:::systemAction
     overview_canceled_end:::terminal
